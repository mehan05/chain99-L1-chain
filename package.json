{
  "name": "chain99-l1-chain",
  "version": "1.0.0",
  "description": "Chain99 is a minimal working prototype of an Ethereum-compatible L1/devnet. This project demonstrates how to build and operate an independent blockchain network capable of executing EVM smart contracts.",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "test:integration": "node test/native-integration.test.js",
    "test:evm": "node scripts/verify-evm.js",
    "test:benchmark": "node scripts/benchmark-tps.js",
    "init:devnet": "node scripts/init-devnet.js",
    "start:devnet": "node scripts/start-devnet.js",
    "deploy:storage": "hardhat run scripts/deploy.js --network chain99",
    "deploy:staking": "hardhat run scripts/deploy-staking.js --network chain99",
    "frontend:dev": "npm --prefix frontend-next run dev",
    "frontend:build": "npm --prefix frontend-next run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehan05/chain99-L1-chain.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mehan05/chain99-L1-chain/issues"
  },
  "homepage": "https://github.com/mehan05/chain99-L1-chain#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.28.0"
  }
}
