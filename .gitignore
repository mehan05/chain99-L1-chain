# =============================================================
# Chain99 L1 — .gitignore
# =============================================================

# ── Geth Binary (too large for git — downloaded by setup.sh) ─
geth/geth
geth/config/

# ── Blockchain Runtime Data ───────────────────────────────────
data/
*.log
*.ipc

# ── Node.js ───────────────────────────────────────────────────
node_modules/
client/node_modules/
frontend-next/node_modules/

# ── Next.js Build Artifacts ──────────────────────────────────
frontend-next/.next/
frontend-next/out/
frontend-next/.vercel/

# ── Environment / Secrets ────────────────────────────────────
.env
.env.local
.env.*.local

# ── OS & Editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# ── Compiled Contracts ────────────────────────────────────────
contracts/artifacts/
contracts/cache/
contracts/out/

# ── Logs / Misc ───────────────────────────────────────────────
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
dist/
tmp/
